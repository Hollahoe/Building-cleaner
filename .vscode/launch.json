{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "웹 창구 실행 (http://127.0.0.1:8000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_web.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "웹 창구 실행 (코드 고치면 자동 재시작)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_web.py",
      "args": ["--reload"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "테스트 전체 실행 (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
