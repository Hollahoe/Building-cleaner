# 복사해서 .env로 쓰거나, 호스팅 서비스의 환경 변수 설정에 같은 이름으로 넣으세요.
# .env 파일은 git에 올리지 않습니다(.gitignore).

# 사이트에 보이는 이름. 상표 등록 여부를 확인한 뒤 바꾸세요(KIPRIS).
BRAND_NAME=모아관리(가칭)
# 첫 화면에 나오는 집중 지역
SERVICE_AREA=마포구
CONTACT_PHONE=
CONTACT_EMAIL=
# 카카오톡 채널 채팅 링크(있으면 메뉴와 완료 화면에 버튼이 생김)
KAKAO_URL=
# 꼬리말의 사업자 정보: 상호, 대표자, 사업자등록번호, 주소
BUSINESS_INFO=사업자 정보는 사업자등록 후 기재합니다.
# 첫 화면 '비용' 문구. 확정된 조건만 적으세요.
FEE_TEXT=줄어든 운영비의 일부만 보수로 받습니다. 줄지 않으면 받지 않습니다.
# 개인정보 보호 책임자 이름·직책
PRIVACY_OFFICER=

# 관리자 화면(/admin) 비밀번호. 비워 두면 관리자 화면이 잠깁니다. 아이디는 admin.
ADMIN_PASSWORD=
# SQLite 파일 위치. 호스팅에서는 재시작해도 지워지지 않는 디스크 경로로 지정하세요.
DATABASE_PATH=data/app.db
# HTTPS로 서비스할 때 true
COOKIE_SECURE=false
