# 복사해서 .env로 쓰거나, 호스팅 서비스(Vercel 등)의 환경 변수 설정에 같은 이름으로 넣으세요.
# .env 파일은 git에 올리지 않습니다(.gitignore). 비밀번호·DB 주소를 코드에 적지 마세요.

# ---- 사이트에 보이는 정보 ------------------------------------------------
# 상표 등록 여부를 확인한 뒤 확정하세요(KIPRIS).
BRAND_NAME=빌딩모아관리
# 첫 화면에 나오는 집중 지역(구)
SERVICE_AREA=마포구
# '우리 동네 공동구매 신청'에서 고르는 동 목록(쉼표로 구분). 비워 두면 직접 입력만 받습니다.
# 행정동 이름은 구청 홈페이지에서 확인해 넣으세요.
SERVICE_DONGS=
# 같은 동네·같은 항목으로 몇 채가 모이면 견적을 받을지
DEMAND_THRESHOLD=5
CONTACT_PHONE=
CONTACT_EMAIL=
# 카카오톡 채널 채팅 링크(있으면 메뉴와 완료 화면에 버튼이 생김)
KAKAO_URL=
# 꼬리말의 사업자 정보: 상호, 대표자, 사업자등록번호, 주소
BUSINESS_INFO=사업자 정보는 사업자등록 후 기재합니다.
# 첫 화면 '비용' 문구. 확정된 조건만 적으세요.
FEE_TEXT=줄어든 운영비의 일부만 보수로 받습니다. 줄지 않으면 받지 않습니다.
# 개인정보 보호 책임자 이름·직책
PRIVACY_OFFICER=

# ---- 보안 ---------------------------------------------------------------
# 관리자 화면(/admin) 비밀번호. 비워 두면 관리자 화면이 잠깁니다. 아이디는 admin.
ADMIN_PASSWORD=
# HTTPS로 서비스할 때 true (Vercel 배포에서는 true)
COOKIE_SECURE=false

# ---- 저장소 -------------------------------------------------------------
# Supabase 연결 주소(Transaction pooler, 포트 6543). 있으면 Postgres를 씁니다. Vercel에서는 필수.
# 예: postgresql://postgres.[프로젝트ID]:[DB비밀번호]@[호스트]:6543/postgres
DATABASE_URL=
# DATABASE_URL이 없을 때 쓰는 SQLite 파일(로컬 개발, Docker + 디스크 배포용)
DATABASE_PATH=data/app.db
